# AWS
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-west-2
AWS_S3_ENDPOINT_URL=https://your-s3-endpoint

S3_BUCKET=your-bucket-name
TEMP_DIR=/tmp/pdf-pipeline

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
BASE_URL=https://openrouter.ai/api/v1

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_CONTRACT_REVIEW_TASK_QUEUE=contract-review-queue
TEMPORAL_CONTRACT_DOCUMENT_TASK_QUEUE=contract-document-processing-queue
TEMPORAL_CONTRACT_LLM_TASK_QUEUE=contract-llm-queue

# Local worker concurrency
CONTRACT_WORKFLOW_WORKER_CONCURRENCY=50
CONTRACT_DOCUMENT_WORKER_CONCURRENCY=2
CONTRACT_LLM_WORKER_CONCURRENCY=2

# Network timeouts in seconds
S3_CONNECT_TIMEOUT_SECONDS=10
S3_READ_TIMEOUT_SECONDS=60
LLM_REQUEST_TIMEOUT_SECONDS=60

# Optional SDK metrics endpoint, for example 0.0.0.0:9001
TEMPORAL_METRICS_BIND_ADDRESS=
TEMPORAL_WORKER_BUILD_ID=temporal-101-phase-2
LOG_LEVEL=INFO
