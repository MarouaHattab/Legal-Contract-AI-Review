AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-west-2
AWS_S3_ENDPOINT_URL=https://s3.us-west-2.idrivee2.com

S3_BUCKET=temporal-dev
TEMP_DIR=/tmp/pdf-pipeline

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_PDF_ORCHESTRATION_TASK_QUEUE=pdf-pipeline-queue
TEMPORAL_PDF_DOCUMENT_TASK_QUEUE=pdf-document-processing-queue

# Worker concurrency
PDF_WORKFLOW_WORKER_CONCURRENCY=50
PDF_DOCUMENT_WORKER_CONCURRENCY=2

# Provider timeouts (seconds)
S3_CONNECT_TIMEOUT_SECONDS=10
S3_READ_TIMEOUT_SECONDS=60

# Optional operations
